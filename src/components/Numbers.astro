---
import { copy } from '../content/copy.js';
const { numbers } = copy;
---
<section class="numbers" aria-labelledby="numbers-title">
  <div class="wrap">
    <p class="eyebrow" id="numbers-title">{numbers.eyebrow}</p>
    <div class="stats">
      {numbers.items.map((s) => (
        <div class="stat">
          <div class="big">{s.big}</div>
          <p>{s.text}{s.source && <sup><a href={`#s${s.source}`} aria-label={`Source ${s.source}`}>{s.source}</a></sup>}</p>
        </div>
      ))}
    </div>
  </div>
</section>
