---
import { copy } from '../content/copy.js';
const { site, menu } = copy;
const base = site.orderUrl.split('?')[0];
const orderFor = (name) => `${base}?text=${encodeURIComponent(`Hi Green Leaf Pizza, I'd like to order: ${name}.`)}`;
---
<section class="menu" id="menu" aria-labelledby="menu-title">
  <div class="wrap">
    <div class="menu-head">
      <div>
        <p class="eyebrow">{menu.eyebrow}</p>
        <h2 id="menu-title">{menu.title}</h2>
      </div>
      <p class="note">{menu.note}</p>
    </div>

    <div class="menu-cols">
      {menu.pizzas.map((sec) => (
        <div class="menu-sec reveal">
          <div class="sec-head">
            <h3>{sec.title}</h3>
            <span class="sizes">{menu.sizes}</span>
          </div>
          {sec.note && <p class="sec-note">{sec.note}</p>}
          <ul>
            {sec.items.map((it) => (
              <li>
                <div class="line">
                  <span class="name">{it.name}{it.vegan && <span class="tag">Vegan</span>}</span>
                  <span class="price">{it.price}</span>
                </div>
                <p class="desc">{it.desc}</p>
                <a class="order-link" href={orderFor(it.name)}>{menu.order}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="menu-extras">
      {menu.extras.map((sec) => (
        <div class="menu-sec reveal">
          <div class="sec-head"><h3>{sec.title}</h3></div>
          <ul>
            {sec.items.map((it) => (
              <li>
                <div class="line"><span class="name">{it.name}</span><span class="price">{it.price}</span></div>
                {it.desc && <p class="desc">{it.desc}</p>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
