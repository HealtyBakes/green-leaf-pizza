---
import Dot from './Dot.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { copy } from '../content/copy.js';
const { site, hero } = copy;
---
<section class="hero" aria-labelledby="hero-title">
  <img class="hero-img" src={hero.image} alt={hero.imageAlt} width="1800" height="1100" fetchpriority="high">
  <div class="hero-card">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-title">{site.tagline}<Dot /></h1>
    <p class="lede">{hero.lede}</p>
    <p class="descriptor">{site.descriptor}</p>
    <div class="actions">
      <a class="btn btn-primary" href={site.orderUrl}><WhatsAppIcon />{hero.primaryButton}</a>
      <a class="btn btn-ghost" href="#menu">{hero.secondaryButton}</a>
    </div>
  </div>
</section>
