---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { copy } from '../content/copy.js';
const { site, order } = copy;
---
<section class="order" id="order" aria-labelledby="order-title">
  <div class="wrap">
    <div>
      <h2 id="order-title">{order.title}</h2>
      <p>{order.text}</p>
    </div>
    <a class="btn" href={site.orderUrl}><WhatsAppIcon />{order.button}</a>
  </div>
</section>
