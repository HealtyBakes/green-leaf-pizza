---
import { copy } from '../content/copy.js';
const items = copy.ticker;
---
<div class="ticker" aria-label={items.join(', ')}>
  <div class="ticker-track" aria-hidden="true">
    {[0, 1].map(() => (
      <ul>
        {items.map((t) => <li>{t}<img src="/assets/symbol-flour.svg" alt="" width="26" height="33"></li>)}
      </ul>
    ))}
  </div>
</div>
