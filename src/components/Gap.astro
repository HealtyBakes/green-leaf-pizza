---
import { copy } from '../content/copy.js';
const { gap } = copy;
---
<section class="gap" id="gap" aria-labelledby="gap-title">
  <div class="wrap">
    <p class="eyebrow">{gap.eyebrow}</p>
    <h2 id="gap-title" class="reveal">{gap.title}</h2>
    <div class="punches">
      {gap.items.map((g) => (
        <div class="punch reveal"><p class="q">{g.q}</p><p class="a">{g.a}</p></div>
      ))}
    </div>
    <p class="verdict reveal">{gap.verdict}</p>
  </div>
</section>
