---
import { copy } from '../content/copy.js';
const { gap } = copy;
---
<section class="gap" id="gap" aria-labelledby="gap-title">
  <div class="wrap">
    <p class="eyebrow">{gap.eyebrow}</p>
    <h2 id="gap-title">{gap.title}</h2>
    <p class="intro">{gap.intro}</p>
    <div class="rows">
      {gap.items.map((g, i) => (
        <div class="row"><span class="n">{i + 1}</span><h3>{g.title}</h3><p>{g.text}</p></div>
      ))}
    </div>
    <p class="verdict">{gap.verdict}</p>
  </div>
</section>
