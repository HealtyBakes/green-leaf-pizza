---
import { copy } from '../content/copy.js';
const { mark } = copy;
---
<section class="mark" aria-labelledby="mark-title">
  <div class="wrap">
    <div class="symbol"><img src="/assets/symbol-flour.svg" alt={mark.imageAlt} width="240" height="303"></div>
    <div>
      <p class="eyebrow">{mark.eyebrow}</p>
      <h2 id="mark-title">{mark.title}</h2>
      <ol>
        {mark.items.map((r) => <li><b>{r.title}</b><span>{r.text}</span></li>)}
      </ol>
    </div>
  </div>
</section>
