---
import { copy } from '../content/copy.js';
const { site, footer } = copy;
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <div class="cols">
      <div>
        <img src="/assets/logo-reversed.svg" alt="green leaf pizza" width="260" height="46">
        <p style="margin:18px 0 0">{site.parent} · {site.place}</p>
      </div>
      <div>
        <p style="margin:0">{footer.orderPrefix} <a href={site.orderUrl}>{site.orderLabel}</a></p>
        <p style="margin:8px 0 0">© {year} {site.copyright}</p>
      </div>
    </div>
    <div class="sources">
      {footer.sourcesTitle}
      <ol>
        {footer.sources.map((s, i) => <li id={`s${i + 1}`}>{s}</li>)}
      </ol>
    </div>
  </div>
</footer>
