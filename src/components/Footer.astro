---
import { site, sources } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <div class="cols">
      <div>
        <img src="/assets/logo-reversed.svg" alt="green leaf pizza" width="260" height="46">
        <p style="margin:18px 0 0">{site.parent} · {site.place}</p>
      </div>
      <div>
        <p style="margin:0">Order: <a href={site.orderUrl}>{site.orderLabel}</a></p>
        <p style="margin:8px 0 0">© {year} Healthy Bakes</p>
      </div>
    </div>
    <div class="sources">
      Sources
      <ol>
        {sources.map((s, i) => <li id={`s${i + 1}`}>{s}</li>)}
      </ol>
    </div>
  </div>
</footer>
