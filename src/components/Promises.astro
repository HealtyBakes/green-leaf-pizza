---
import { promises } from '../data/site.js';
---
<section class="table" id="table" aria-labelledby="table-title">
  <div class="wrap">
    <p class="eyebrow">What's on the table</p>
    <h2 id="table-title">Everyone eats. Nobody asks.</h2>
    <p class="intro">Four promises, kept in every recipe, so you can order for the whole family without reading the small print.</p>
    <div class="labels">
      {promises.map((p) => (
        <div class="label">
          <span class="pill" style={`background:${p.bg};color:${p.fg}`}>{p.label}</span>
          <p>{p.text}</p>
          {p.off && <p class="off">{p.off}</p>}
        </div>
      ))}
    </div>
  </div>
</section>
