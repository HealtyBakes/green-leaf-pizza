---
import { copy } from '../content/copy.js';
const { promises } = copy;
// Brand colours for each tile tone (design, not copy).
const tones = {
  forest: ['#1C3324', '#FBF7EF'],
  basil: ['#2F5D3A', '#FBF7EF'],
  semolina: ['#E2A93B', '#1C3324'],
  tomato: ['#C2381F', '#FBF7EF'],
};
---
<section class="promises" id="table" aria-labelledby="table-title">
  <div class="wrap">
    <p class="eyebrow">{promises.eyebrow}</p>
    <h2 id="table-title" class="reveal">{promises.title}</h2>
    <p class="intro">{promises.intro}</p>
    <div class="tiles">
      {promises.items.map((p) => {
        const [bg, fg] = tones[p.tone] ?? tones.basil;
        return (
          <div class="tile reveal" style={`background:${bg};color:${fg}`}>
            <h3>{p.label}</h3>
            <p>{p.text}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
