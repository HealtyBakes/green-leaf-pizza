---
import { copy, StoryBody } from '../content/copy.js';
const { story } = copy;
---
<section class="story" id="story" aria-labelledby="story-title">
  <div class="wrap">
    <div>
      <p class="eyebrow">{story.eyebrow}</p>
      <h2 id="story-title">{story.title}</h2>
    </div>
    <div class="body">
      <StoryBody />
      <p class="quote">{story.quote}</p>
    </div>
  </div>
</section>
