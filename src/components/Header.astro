---
import { copy } from '../content/copy.js';
const { site, nav } = copy;
---
<header class="top">
  <div class="wrap">
    <a href="/" aria-label={`${site.name} home`}><img src="/assets/logo.svg" alt="green leaf pizza" width="300" height="52"></a>
    <nav aria-label="Main">
      <ul>
        {nav.links.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a class="btn btn-primary" href={site.orderUrl}>{nav.order}</a></li>
      </ul>
    </nav>
  </div>
</header>
