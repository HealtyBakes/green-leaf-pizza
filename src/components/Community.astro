---
import Dot from './Dot.astro';
import { copy } from '../content/copy.js';
const { community } = copy;
---
<section class="community" aria-label={`${community.line}.`}>
  <div class="wrap">
    <p class="line reveal">{community.line}<Dot /></p>
    <p class="sub">{community.sub}</p>
  </div>
</section>
