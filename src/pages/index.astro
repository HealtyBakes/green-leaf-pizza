---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Gap from '../components/Gap.astro';
import Numbers from '../components/Numbers.astro';
import Story from '../components/Story.astro';
import Mark from '../components/Mark.astro';
import Promises from '../components/Promises.astro';
import Community from '../components/Community.astro';
import Order from '../components/Order.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main id="main">
    <Hero />
    <Gap />
    <Numbers />
    <Story />
    <Mark />
    <Promises />
    <Community />
    <Order />
  </main>
  <Footer />
</Base>
