---
import Base from '../layouts/Base.astro';
import { copy } from '../content/copy.js';
const { notFound } = copy;
---
<Base title={notFound.title}>
  <main id="main" class="notfound">
    <img src="/assets/symbol.svg" alt="" width="90" height="114">
    <h1>{notFound.heading}</h1>
    <a class="btn btn-primary" href="/">{notFound.button}</a>
  </main>
</Base>
<style>
  .notfound{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:28px;text-align:center;padding:24px}
  .notfound h1{font-size:clamp(40px,6vw,64px)}
</style>
